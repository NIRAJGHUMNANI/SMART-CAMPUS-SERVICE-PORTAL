<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Smart Campus</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar"><a class="brand" asp-controller="Home" asp-action="Index">🎓 Smart Campus</a><nav><a asp-controller="Home" asp-action="Index">Dashboard</a><a asp-controller="Requests" asp-action="Index">Service Requests</a><a asp-controller="Requests" asp-action="Create">New Request</a><a href="/api/requests" target="_blank">API JSON</a></nav></header>
<main class="container">@RenderBody()</main>
<footer>Smart Campus Service Portal · ASP.NET Core MVC + SQLite + REST API</footer>
</body>
</html>
