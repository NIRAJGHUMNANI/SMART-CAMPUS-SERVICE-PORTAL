@model ServiceRequest
@{ ViewData["Title"] = "New Request"; }
<div class="page-heading"><div><p class="eyebrow">CAMPUS SERVICES</p><h1>Submit a request</h1><p>Tell us what needs attention.</p></div></div>
<section class="panel form-panel"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div>
<div class="field"><label asp-for="StudentName"></label><input asp-for="StudentName" placeholder="e.g. Aarav Patel"/><span asp-validation-for="StudentName" class="validation"></span></div>
<div class="field"><label asp-for="Category"></label><select asp-for="Category"><option>IT Support</option><option>Maintenance</option><option>Library</option><option>Hostel</option><option>Transport</option><option>Other</option></select><span asp-validation-for="Category" class="validation"></span></div>
<div class="field"><label asp-for="Description"></label><textarea asp-for="Description" rows="4" placeholder="Describe the issue..."></textarea><span asp-validation-for="Description" class="validation"></span></div>
<div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn" type="submit">Submit request →</button></div></form></section>
